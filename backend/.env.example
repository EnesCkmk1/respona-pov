# Copy to .env. Everything is optional — leave blank to run in free stub mode.

ENVIRONMENT=development

# Set to false only once you've wired real providers below.
USE_STUBS=true

# Supabase (server-side service role key — NEVER expose to the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Speech-to-Text
DEEPGRAM_API_KEY=

# Text-to-Speech
ELEVENLABS_API_KEY=

# LLM
ANTHROPIC_API_KEY=
